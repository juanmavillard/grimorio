{
  "name": "grimorio",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "python3 -m http.server 4173 --bind 127.0.0.1",
    "test": "node --test test/*.test.js",
    "docs:generate": "node scripts/generate-character-manuals.js",
    "docs:check": "node scripts/check-docs.js",
    "check": "npm run lint && npm run format:check && node scripts/check-module-graph.js && node scripts/check-syntax.js && npm run release:check && node scripts/check-docs.js && node scripts/check-app-shell.js && node scripts/check-desktop.js && npm test",
    "test:browser": "node browser-checks/trouble-brewing.js",
    "test:browser:bmr": "node browser-checks/bad-moon-rising.js",
    "test:browser:storage": "node browser-checks/active-store.js",
    "test:browser:crash": "node browser-checks/storage-crash.js",
    "test:browser:snv": "node browser-checks/sects-and-violets.js && node browser-checks/sects-twins.js",
    "test:browser:offline": "node browser-checks/offline-accessibility.js",
    "test:browser:offline:webkit": "GRIMORIO_BROWSER=webkit node browser-checks/offline-accessibility.js",
    "test:browser:deal": "node browser-checks/deal-storage.js",
    "test:browser:game": "node browser-checks/game-actions.js",
    "test:browser:all": "npm run test:browser && npm run test:browser:bmr && npm run test:browser:snv && npm run test:browser:deal && npm run test:browser:game && npm run test:browser:storage && npm run test:browser:crash && npm run test:browser:offline && npm run test:browser:consolidation && npm run test:browser:update && npm run test:browser:long && npm run test:browser:preventive",
    "release:generate": "node scripts/build-release.js",
    "release:check": "node scripts/build-release.js --check",
    "test:browser:consolidation": "node browser-checks/consolidation.js",
    "test:browser:update": "node browser-checks/pwa-update.js",
    "test:browser:long": "node browser-checks/long-games.js",
    "desktop:start": "electron .",
    "desktop:prepare": "node node_modules/electron/install.js",
    "desktop:check": "node scripts/check-desktop.js",
    "desktop:build:mac": "node scripts/desktop-build.js mac",
    "desktop:build:win": "node scripts/desktop-build.js win",
    "test:desktop": "node browser-checks/desktop.js",
    "test:desktop:package": "node browser-checks/desktop.js --packaged",
    "lint": "eslint src desktop scripts test browser-checks",
    "format:check": "prettier --check \"src/**/*.js\" \"desktop/**/*.{js,cjs,json}\" \"scripts/**/*.js\" \"test/**/*.js\" \"browser-checks/**/*.js\" eslint.config.js",
    "format": "prettier --write \"src/**/*.js\" \"desktop/**/*.{js,cjs,json}\" \"scripts/**/*.js\" \"test/**/*.js\" \"browser-checks/**/*.js\" eslint.config.js",
    "pdf:generate": "node scripts/build-player-pdfs.js",
    "test:browser:preventive": "node browser-checks/preventive.js",
    "kit:generate": "node scripts/build-friend-kit.js",
    "kit:generate:win": "node scripts/build-friend-kit.js win",
    "clean": "node scripts/clean-generated.js",
    "demo:build": "npm run release:check && node scripts/prepare-portfolio.js demo",
    "demo:start": "python3 -m http.server 4174 --bind 127.0.0.1 --directory output/demo",
    "portfolio:prepare": "npm run release:check && node scripts/prepare-portfolio.js source",
    "test:demo": "npm run demo:build && node browser-checks/demo.js",
    "portfolio:check": "node scripts/prepare-portfolio.js source --check"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "eslint": "9.39.1",
    "playwright": "^1.63.0",
    "prettier": "3.6.2"
  },
  "main": "desktop/main.js",
  "description": "Offline Storyteller companion for in-person Blood on the Clocktower games",
  "author": "Juanma Villard",
  "license": "UNLICENSED"
}
